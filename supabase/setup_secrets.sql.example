-- Secrets for reminder delivery (Web Push). Run once per project in the SQL editor.
-- Generate VAPID keys with:  npx web-push generate-vapid-keys
select vault.create_secret('https://<project-ref>.supabase.co', 'reminders_project_url');
select vault.create_secret('<random 64-char string>',           'reminders_dispatch_secret');
select vault.create_secret('<VAPID public key>',                'vapid_public_key');
select vault.create_secret('<VAPID private key>',               'vapid_private_key');
select vault.create_secret('https://your-app-domain',           'vapid_subject');
-- Then put the same VAPID public key in VITE_VAPID_PUBLIC_KEY.
